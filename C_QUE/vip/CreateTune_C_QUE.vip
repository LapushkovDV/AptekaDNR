/*************************************************************************************************\
* Наименование:  Настройки для интеграции с dMDM                                              *
* Контур/Модуль: Интеграция                                                                       *
* Примечание:                                                                                     *
\*************************************************************************************************/

#include CreateTune.vih
//------------------------------------------------------------------------------
Handler with replace CreateTune_C_QUE on extensionPoint epCreateTuneComponent (TR: ObjCreateTuneEx) [220]
  // Внимание, приоритеты вызова обработчиков см. в CreateTune.vih
Action
{
  Result := true;
  TR.SetComponent('GP');
  // ------------------------------------------------------------------------
  TR.SetParent('Tune');
  TR.AddPartA('AVTOVAZ','АвтоВАЗ','');

  TR.SetParent('AVTOVAZ');
  // ------------------------------------------------------------------------
  // Создаём разделы настроек

  TR.AddPartA('C_QUE','Очередь','');
  TR.SetParent('C_QUE');
  TR.AddTuneS('QUE_OUT_CLEAR_COUNT_DAYS_SUCCESS', 'Количество дней для хранения записей успешной передачи', ftword, '', '100', hcNoContext);
  TR.AddTuneS('QUE_OUT_CLEAR_COUNT_DAYS_ERROR'  , 'Количество дней для хранения записей передачи с ошибкой', ftword, '', '100', hcNoContext);
}
